[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=Torch
GenericName=TerminalEmulator

Exec=torch %U
StartupWMClass=dev.tombyte.Torch

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.tombyte.Torch

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for torch:// URLs.
MimeType=x-scheme-handler/torch;
